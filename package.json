{
  "name": "lil-bitz",
  "version": "1.0.0",
  "description": "Lil Bitz \u2014 a cosy beachcombing game in Lys's Project R\u016bMOKO universe",
  "scripts": {
    "test": "vitest run",
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "gate": "node agent/gate.mjs",
    "shot": "node agent/shot.mjs",
    "world": "node agent/dump-world.mjs",
    "verify": "npm run test && npm run world && npm run shot && npm run shot-title && npm run shot-world && npm run shot-epic && npm run shot-give && npm run shot-cryptid && npm run shot-doorway",
    "shot-give": "node agent/shot-give.mjs",
    "shot-title": "node agent/shot-title.mjs",
    "shot-world": "node agent/shot-world.mjs",
    "tour": "node agent/tour.mjs",
    "artifact": "vite build && node agent/inline.mjs",
    "play": "node agent/playthrough.mjs",
    "sim": "node agent/sim-loot.mjs",
    "shot-epic": "node agent/shot-epic.mjs",
    "shot-cryptid": "node agent/shot-cryptid.mjs",
    "shot-doorway": "node agent/shot-doorway.mjs"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "alea": "^1.0.1",
    "simplex-noise": "^4.0.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
